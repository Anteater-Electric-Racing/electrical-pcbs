	(text "total resistance\n510*5+39=2,589k\ncurrent:\n420/2.589Mohm = 162uA\nmax power\n(162E-6)^2*510E3 =\n0.0134 W\nmuch less than rated 1/8W"
		(exclude_from_sim no)
		(at 474.726 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "20862f4b-3bc4-4c41-acfc-b4492a49cb2f")
	)
	(text "Inputs"
		(exclude_from_sim no)
		(at 340.614 213.36 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "27777916-81d4-46cf-9ade-8b1e62ec87a4")
	)
	(text "1.25A fuse has cold ohms of 134mohm. \nseries resistor guarantees total reistance\nis >434mohm.\ns/c current is 420/0.434 = 968A\nwhich is less than 1kA fusing current\nat fusing current, series resistor dissapates\n1.25^2*0.3 = 0.46875 W\n0.47<<2W resistor rating\n"
		(exclude_from_sim no)
		(at 38.862 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "332f7273-263f-4818-97b2-89b21089f826")
	)
	(text "forward voltage of opto is 1.3v. bias current is \n(12-1.3)/ (2*390) = 0.0137mA, power is\n0.0137^2*390 = 0.0732W\n0805 is rated for 1/8W (0.125W)\n12.5mW>7.32mW, resistor has plenty of margin"
		(exclude_from_sim no)
		(at 395.732 138.938 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "336783bc-aeb4-4603-9b5f-bf415a69792b")
	)
	(text "AIRs"
		(exclude_from_sim no)
		(at 62.484 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "36a67888-369f-4c62-8738-822bf4144531")
	)
	(text "each resistor dissapates\n210v^2/2700r = 16.3W\nheatsink is 3.7 C/W \nheat rise\n60.43 C rise"
		(exclude_from_sim no)
		(at 61.722 272.288 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3fc6eaeb-455c-42b7-9412-e0a1589b86d2")
	)
	(text "both TSMP resistors dissapate\n420^2/30000 = 5.88W\nthats 2.94 W/resistor\n\nthe heatsinks are rated for 16.3C/W (natural)\ntemp rise is 16.3*2.94 = 47.9 C "
		(exclude_from_sim no)
		(at 65.024 198.374 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "414539e8-8304-4b87-9aa6-042eb7aa02c0")
	)
