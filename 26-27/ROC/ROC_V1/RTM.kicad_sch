	)
	(text "when high voltage is 60 V DC. the signal \ntaken HIGH_VOLTAGE_IN should be 1.3 VDC. \n\nWhen V bias is calculated it's just \nchecking if the high voltage is above 60.\nWhen the V_BiAS > HIGH_VOLTAGE_IN then \nvoltage outside battery pack is NOT 60 V "
		(exclude_from_sim no)
		(at 41.402 162.814 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "974ce0b8-bf9e-42e1-a5dc-995e4652fbfb")
	)
	(text "HIGH_VOLTAGE_IN = (APROX) 1.3 V\n"
