				(size 5.08 5.08)
			)
		)
		(uuid "ce6791dc-0a14-4a0d-a175-93cdfd4cf062")
	)
	(text "when output HIGH, PMOS open, optocoupler stays open, RTM pulled high.\n\nwhen output LOW, PMOS closes, optocoupler closes, RTM pulled low \n\nRTM HIGH --> HIGH_VOLTAGE > 60 V \nRTM LOW  --> HIGH VOLTAGE < 60 V"
		(exclude_from_sim no)
		(at 160.528 88.646 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ea4b2d6d-44bc-4654-a39f-1072990b28a2")
	)
