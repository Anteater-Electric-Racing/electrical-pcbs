		(at 106.426 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ba66bdad-a500-476f-b8fd-fd052757304e")
	)
	(text "compares HIGH_VOLTAGE_IN to V_BIAS\n\noutput goes: \nopen when HIGH_VOLTAGE_IN > V_BIAS\nshort to ground when HIGH_VOLTAGE_IN < V_BIAS"
		(exclude_from_sim no)
		(at 65.278 90.678 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bfa706cf-bf8b-41d6-b2b3-615fcd075eb7")
	)
	(text "HIGH_VOLTAGE\n"
