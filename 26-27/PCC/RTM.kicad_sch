	)
	(text_box "DEBUG_1, DEBUG_2, DEBUG_3 are LEDs meant for debugging the circuit.\n"
		(exclude_from_sim no)
		(at 210.82 29.21 0)
		(size 30.48 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 239 242 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "00ee47f2-6a25-46b1-acdb-9a9aa27f5f8a")
	)
	(text_box "The high voltage is converted down through a voltage divider network to form V_IN. \n\nThese resistors are rated for at least 0.125W to ensure proper performance at high voltages.\n\n420^2/(540000*5+20000*3) = 0.0648529412W total"
		(exclude_from_sim no)
		(at 28.956 138.938 0)
		(size 29.21 29.464)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 239 242 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "17d03700-b6cb-47c7-9e59-11000be6b3d1")
	)
	(text_box "The comparator compares if V_IN is larger than V_BIAS. If true, then the system is above 60V."
		(exclude_from_sim no)
		(at 91.186 18.796 0)
		(size 31.75 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 239 242 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "751bd34e-ad6c-406c-b38c-cf1d835c05a5")
	)
	(text_box "This DC DC isolated converter separates galvanically high voltage and low voltage.\n\nV_BIAS is a tunable voltage that affects when the amber LED flashes.\n\nThe Grounds of HV and this unisolated LV is tied together to ensure proper operation of the comparator."
		(exclude_from_sim no)
		(at 264.16 119.38 0)
		(size 26.67 31.75)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 239 242 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b345d7b3-0447-4990-b140-28db74752e4f")
	)
	(text_box "The optocoupler network isolates high voltage from low voltage."
		(exclude_from_sim no)
		(at 161.29 40.64 0)
		(size 17.78 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
