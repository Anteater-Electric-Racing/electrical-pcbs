	)
	(text "12V TO 12V ISOLATED DC DC CONVERTER"
		(exclude_from_sim no)
		(at 204.978 116.84 0)
		(effects
			(font
				(size 3 3)
			)
		)
		(uuid "d69d3fb2-f9d3-4128-a88b-b470b0941526")
	)
	(text "24k\n"
		(exclude_from_sim no)
		(at 224.282 43.434 0)
