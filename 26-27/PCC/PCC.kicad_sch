	(text "pinout of this connector is keyed so swapping\nwith one of the other 4 pins\nresults in the AIR+ being connected reverse\nwhich will not close the AIRs due to built\nin economizer caring about polarity"
		(exclude_from_sim no)
		(at 61.468 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a86be6e7-6e7e-4a63-bb4e-01402527416f")
	)
	(text "HV IN\n"
		(exclude_from_sim no)
		(at 42.672 72.898 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "af4868b3-9642-469c-85ca-58380fb1bf4f")
	)
	(text "both TSMP resistors dissapate\n420^2/30000 = 5.88W\nthats 2.94 W/resistor\n\nthe heatsinks are rated for 16.3C/W (natural)\ntemp rise is 16.3*2.94 = 47.9 C "
		(exclude_from_sim no)
		(at 67.564 198.374 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b252c1bc-ed25-4df7-82b5-08ea692e9e3a")
	)
	(text "12V to 12V Isolated DCDC Converter\n"
		(exclude_from_sim no)
		(at 417.322 212.852 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d389250c-fcbc-46c7-bd8b-5dd60aa23e24")
	)
	(text "3.5nA bias\nfor low \ninputsag\n3.5nA * 2.5Mohm\n=8.7mV\nmax divider in is\n420*39/(39+510*5)=6.3V\nerror is \n0.0087/6.3=0.14%"
		(exclude_from_sim no)
		(at 441.198 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6d7646d-4eea-440e-8a98-5f82a4ccdb05")
	)
