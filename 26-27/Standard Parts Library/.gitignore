# Machine-local state written by the Library Manager
Anteater Parts/appdata/.writer.lock
Anteater Parts/appdata/pending-transaction.json
Anteater Parts/appdata/backups/*
!Anteater Parts/appdata/backups/.gitkeep
__pycache__/
*.pyc
node_modules/

# Generated locally from appdata/components.csv by the Library Manager (launcher, Publish,
# Setup). KiCad keeps it open, so it must not be in git: Windows cannot replace an open file.
Anteater Parts/appdata/parts.sqlite
